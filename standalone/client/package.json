{
  "name": "sov-standalone-client",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "bun build ./src/main.tsx --outfile ../dist/app.js --target browser --minify && bun x @tailwindcss/cli -i ./src/theme.css -o ../dist/theme.css --minify && cp ./index.html ../dist/index.html",
    "typecheck": "bun x tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@tanstack/react-query": "5.100.10",
    "react": "19.2.5",
    "react-dom": "19.2.5"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.1.13",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "tailwindcss": "4.1.13",
    "tailwindcss-safe-area": "1.3.0",
    "typescript": "5.6.3"
  }
}
